    {
      "label": "料金",
      "value": "API従量課金（一部無料枠あり）",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "label": "提供開始",
      "value": "ERモデルはGoogle AI Studioで公開中",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "label": "日本での提供",
      "value": "ERモデルはGoogle AI Studioから利用可能",
      "sources": [
