      ]
    },
    {
      "label": "使える場所",
      "value": "Google AI Studio、Vertex AI",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "label": "向いている人",
      "value": "ロボット開発者や研究者",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration",
        "google-deepmind-gemini-robotics-2-apollo"
      ]
    }
  ],
  "capabilities": [
    {
      "text": "20自由度を超える多指ハンドを制御し、薄いゴミ袋の紐結びや電球の取り外しといった精密な操作を行えます。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "text": "全身制御により、膝を曲げて重心のバランスを保ちながら、床に置かれた物を自律回収できます。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration",
        "gemini-robotics-2-comprehensive-summary-matome"
      ]
    },
    {
      "text": "複数のロボットが自然言語の音声指示を受け、自律的に役割を分担して連携作業を遂行できます。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration",
        "google-deepmind-gemini-robotics-2-apollo"
      ]
    },
    {
      "text": "障害物による妨害や対象物の位置のずれに対し、視覚フィードバックを用いてリアルタイムに動作を補正します。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    }
  ],
  "pricing": [
    {
      "text": "Embodied Reasoningモデルは従量課金制の標準API料金で提供されます。一部の無料枠も用意されています。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "text": "ロボットの関節等を制御するActionモデルの料金は明らかにされていません。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    }
  ],
  "japan": [
    {
      "text": "Embodied ReasoningモデルはGoogle AI Studio経由で日本からも利用できます。日本語による指示や空間問合せにも対応しています。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "text": "実機に適用するActionモデルは「Trusted Tester Program」への事前申請が必要です。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    }
  ],
  "howto": [
    {
      "text": "Googleアカウントを用意し、Google AI Studioのコンソールにログインします。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "text": "APIキーを発行し、モデルエンドポイントを指定して画像やプロンプトを送信します。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    }
  ],
  "differences": [
    {
      "text": "従来のGemini Robotics 1.5と比べて、時系列動画の進行状況を正確に認識できます。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "text": "前世代モデルが主に上半身の制御だったのに対し、脚部を含めた全身の協調制御に対応しました。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    }
  ],
  "faq": [
    {
      "q": "無料で試せますか？",
      "a": "Google AI Studioのモデルには一部無料枠が用意されています。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "q": "音声指示で操作できますか？",
      "a": "自然言語の音声指示を解釈し、自律的に作業を構築して実行できます。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration",
        "google-deepmind-gemini-robotics-2-apollo"
      ]
    },
    {
      "q": "人間が遠隔操作していますか？",
      "a": "遠隔操作は行われず、ロボット自身が状況を認識して完全自律で動作します。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "q": "どのようなロボットに対応していますか？",
      "a": "人型ロボットのApolloや多関節ハンド、作業用アームなど多様な機種に対応します。",
      "sources": [
        "gemini-robotics-2-comprehensive-summary-matome",
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    },
    {
      "q": "どのような安全機能がありますか？",
      "a": "指示が曖昧な際に確認質問を行う機能や、オープンソース評価基盤ASIMOV Agenticを備えます。",
      "sources": [
        "google-deepmind-gemini-robotics-2-multi-robot-collaboration"
      ]
    }
  ],
