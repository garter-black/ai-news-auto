      ]
    }
  ],
  "faq": [
    {
      "q": "無料で使える？",
      "a": "既存のCopilotプランの契約が前提となり、通常のプランに含まれて追加料金なしで利用できる。",
      "sources": [
        "github-copilot-native-app-released",
        "github-copilot-security-extension"
      ]
    },
    {
      "q": "セキュリティ機能は勝手にコードを変更する？",
      "a": "変更はローカルの作業用コピーにのみ行われ、勝手にコミットやプッシュをされないため安全にレビューできる。",
      "sources": [
        "github-copilot-security-extension"
      ]
    },
    {
      "q": "どのモデルが使える？",
      "a": "Kimi K3などのフロンティア級LLMがモデル選択肢に追加されており、タスクに応じて切り替えられる。",
      "sources": [
        "github-copilot-kimi-k3-multi-agent"
      ]
    },
    {
      "q": "開発者以外でも使える？",
      "a": "GitHub社の法務チームなど非開発者の部門でも、契約書のドラフト作成などの業務に導入されている。",
      "sources": [
        "github-copilot-native-app-released"
      ]
    }
