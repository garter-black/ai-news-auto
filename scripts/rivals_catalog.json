{
  "_about": "製品の記事の「同じクラスの製品と比べると？」（scripts/rivals.py）で使う分類・項目・ライバルの候補。rivals の url は各メーカーの公式ページだけ（販売店・比較サイトは入れない）。値はここに書かない（毎回公式ページから読み取る）",
  "fields": {
    "weight": {
      "label": "重さ",
      "units": [
        "kg",
        "g"
      ],
      "labels": "重量|重さ|車重|weight",
      "compare": true,
      "words": [
        "軽い",
        "重い"
      ],
      "deny": "ドライブユニット|ユニット|モーター|バッテリー|充電器|motor|battery|charger",
      "allow": "車体|車両|本体|参考重量|総重量|車重",
      "hint": "製品全体の重さ（参考重量・車両重量・本体重量）。モーター・バッテリーなど部品だけの重さは入れない。サイズ違いで複数あれば「23.3〜23.7kg（S〜L）」のように範囲で書き、測ったサイズがあれば（）で添える。イヤホンは片耳（本体）の重さだけで、ケース込みの重さと混ぜない。付属品込み・別の部品の重さを範囲にまとめない"
    },
    "motor": {
      "label": "モーター",
      "units": [],
      "labels": "ドライブユニット|モーター|motor|drive ?unit",
      "hint": "モーター（ドライブユニット）のメーカーと型名だけ。トルク・出力の数字は入れない"
    },
    "torque": {
      "label": "最大トルク",
      "units": [
        "Nm"
      ],
      "labels": "トルク|torque",
      "compare": true,
      "words": [
        "小さい",
        "大きい"
      ],
      "hint": "モーターの最大トルク（Nm）"
    },
    "power": {
      "label": "最大出力",
      "units": [
        "kW",
        "W",
        "PS",
        "馬力"
      ],
      "labels": "最大出力|出力|power",
      "compare": true,
      "words": [
        "小さい",
        "大きい"
      ],
      "exclude": "定格|rated|nominal|continuous",
      "hint": "最大（ピーク）出力。定格出力は別のものなので入れない（定格しか無ければこの項目は出さない）"
    },
    "battery": {
      "label": "バッテリー",
      "units": [
        "kWh",
        "Wh",
        "mAh",
        "Ah"
      ],
      "labels": "バッテリー|battery|電池",
      "compare": true,
      "words": [
        "小さい",
        "大きい"
      ],
      "hint": "バッテリー容量。ページの書き方のまま（Wh・Ah・mAh など。換算しない）。別売りの増設バッテリーは入れない"
    },
    "fork": {
      "label": "前サスペンション",
      "units": [
        "mm"
      ],
      "labels": "フォーク|フロントサスペンション|前サス|fork",
      "hint": "前サスペンション（フォーク）のトラベル量（mm）。型名があれば添えてよい"
    },
    "wheels": {
      "label": "ホイール",
      "units": [
        "インチ",
        "inch",
        "\"",
        "″",
        "×"
      ],
      "labels": "ホイール|タイヤサイズ|wheel",
      "hint": "前後の車輪の大きさ（インチ）。前後で違えば「前29インチ・後27.5インチ」"
    },
    "display": {
      "label": "画面",
      "units": [
        "インチ",
        "型",
        "inch",
        "\"",
        "″"
      ],
      "labels": "ディスプレイ|画面|display|screen",
      "hint": "画面の大きさ（インチ・型）。解像度は入れない"
    },
    "chip": {
      "label": "チップ",
      "units": [],
      "labels": "チップ|プロセッサ|CPU|SoC|chip|processor",
      "hint": "搭載するチップ（CPU・SoC）の名前"
    },
    "memory": {
      "label": "メモリ",
      "units": [
        "GB",
        "TB"
      ],
      "labels": "メモリ|RAM|memory",
      "hint": "標準のメモリ容量（最小構成）"
    },
    "storage": {
      "label": "ストレージ",
      "units": [
        "GB",
        "TB"
      ],
      "labels": "ストレージ|SSD|容量|storage",
      "hint": "標準のストレージ容量（最小構成）"
    },
    "battery_life": {
      "label": "電池持ち（公式値）",
      "units": [
        "時間",
        "hours",
        "hrs"
      ],
      "labels": "駆動時間|再生時間|バッテリー駆動|battery life",
      "compare": true,
      "words": [
        "短い",
        "長い"
      ],
      "hint": "公式の最大駆動時間・再生時間（条件があれば添える）"
    },
    "camera": {
      "label": "カメラ",
      "units": [
        "MP",
        "万画素",
        "画素",
        "メガピクセル"
      ],
      "labels": "カメラ|画素|camera",
      "hint": "メインカメラの画素数"
    },
    "range_km": {
      "label": "航続距離（公式値）",
      "units": [
        "km"
      ],
      "labels": "航続距離|一充電走行距離|range",
      "compare": true,
      "words": [
        "短い",
        "長い"
      ],
      "hint": "公式の航続距離・一充電走行距離（測り方の条件・モードがあれば添える）"
    },
    "displacement": {
      "label": "排気量",
      "units": [
        "cc",
        "cm3",
        "cm³",
        "L"
      ],
      "labels": "排気量|displacement",
      "hint": "エンジンの総排気量"
    },
    "fuel": {
      "label": "燃費（公式値）",
      "units": [
        "km/L"
      ],
      "labels": "燃費|燃料消費率|WLTC",
      "hint": "公式の燃費（WLTCモードなど測り方を添える）"
    },
    "size": {
      "label": "大きさ",
      "units": [
        "mm"
      ],
      "labels": "全長|寸法|サイズ|dimensions",
      "hint": "全長×全幅×全高（mm）"
    }
  },
