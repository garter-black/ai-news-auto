  "model_re": "GPT[-‐ ]?\\d|ChatGPT|(?<![A-Za-z])Sora\\s?\\d|Claude\\s?(?:\\d|Opus|Sonnet|Haiku)|Gemini\\s?\\d|Gemma\\s?\\d|(?<![A-Za-z])Veo\\s?\\d|Llama\\s?\\d|(?<![A-Za-z])Grok\\s?\\d|DeepSeek[- ]?(?:V|R)\\d|Qwen\\s?\\d|Kimi[- ]?K\\d|GLM[- ]?\\d|(?<![A-Za-z])Command (?:A|R)(?![A-Za-z])|(?<![A-Za-z])Embed \\d|(?:Mistral|Mixtral|Ministral|Magistral|Codestral|Devstral)\\s?(?:\\d|Large|Medium|Small)|Stable (?:Diffusion|Audio|Video|Image) ?\\d|Eleven (?:v\\d|Music|Turbo)|(?<![A-Za-z])Nova (?:\\d|Pro|Premier|Lite|Sonic)|Nemotron|PLaMo|tsuzumi|Sarashina|Granite \\d|Phi-\\d|MAI-\\d|(?<![A-Za-z])(?:Cursor|Notion|Figma|Canva) ?\\d(?:\\.\\d)?(?![\\d.])",
